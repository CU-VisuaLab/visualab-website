---
import Base from '../../layouts/Base.astro';import {people} from '../../lib/data';const members=await people();
---
<Base title="People"><section class="page-hero"><div class="wrap"><div class="eyebrow">Our community</div><h1>People</h1><p>Researchers, students, collaborators, and alumni who make VisuaLab possible.</p></div></section><section class="section"><div class="wrap">{(['current','collaborator','alumni'] as const).map(status=><div style="margin-bottom:55px"><div class="section-head"><h2>{status==='current'?'Lab members':status==='collaborator'?'Collaborators':'Alumni'}</h2></div><div class="card-grid">{members.filter(p=>p.data.status===status).map(p=><div class="card"><div class="card-visual">{p.data.image?<img src={p.data.image} alt={`Portrait of ${p.data.name}`}/>:p.data.name.slice(0,1)}</div><div class="card-body"><h3>{p.data.website?<a href={p.data.website}>{p.data.name} ↗</a>:p.data.name}</h3><p>{p.data.role}</p></div></div>)}</div></div>)}</div></section></Base>
