---
import Base from '../../layouts/Base.astro';import {publications,themes} from '../../lib/data';const papers=await publications();const areas=await themes();
---
<Base title="Publications"><section class="page-hero"><div class="wrap"><div class="eyebrow">Scholarship</div><h1>Publications</h1><p>Explore our research papers, systems, and contributions.</p></div></section><section class="section"><div class="wrap"><div class="filters"><label>Search publications<input id="search" type="search" placeholder="Title, author, venue…"/></label><label>Research area<select id="theme"><option value="">All areas</option>{areas.map(t=><option value={t.id}>{t.data.title}</option>)}</select></label><label>Year<select id="year"><option value="">All years</option>{[...new Set(papers.map(p=>p.data.year))].map(y=><option value={y}>{y}</option>)}</select></label></div><p id="count" aria-live="polite"></p><div id="papers">{papers.map(p=><article class="pub" data-search={`${p.data.title} ${p.data.authors.join(' ')} ${p.data.venue}`.toLowerCase()} data-themes={p.data.themes.join(' ')} data-year={p.data.year}><div class="pill">{p.data.year} · {p.data.venueShort||p.data.venue}</div><h3><a href={`/publications/${p.id}/`}>{p.data.title}</a></h3><p>{p.data.authors.join(', ')}</p><div class="pub-links">{p.data.links.map(l=><a href={l.url}>{l.label} ↗</a>)}</div></article>)}</div></div></section></Base><script>const search=document.querySelector<HTMLInputElement>('#search')!;const theme=document.querySelector<HTMLSelectElement>('#theme')!;const year=document.querySelector<HTMLSelectElement>('#year')!;const rows=[...document.querySelectorAll<HTMLElement>('.pub')];function filter(){let count=0;for(const row of rows){const show=(row.dataset.search||'').includes(search.value.toLowerCase().trim())&&(!theme.value||(row.dataset.themes||'').split(' ').includes(theme.value))&&(!year.value||row.dataset.year===year.value);row.hidden=!show;if(show)count++}document.querySelector('#count')!.textContent=`${count} publication${count===1?'':'s'}`;}[search,theme,year].forEach(el=>el.addEventListener('input',filter));filter();</script><style>.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px}.filters label{font-size:12px;font-weight:800;color:#627488}.filters input,.filters select{display:block;width:100%;padding:12px;border:1px solid #dce6ec;border-radius:5px;background:#fff;margin-top:8px;font:inherit;font-weight:400;color:#172b40}#count{color:#627488;font-size:13px}.pub[hidden]{display:none}@media(max-width:750px){.filters{grid-template-columns:1fr}}</style>
