---
import { siteUrl } from '../lib/urls';
import Base from '../layouts/Base.astro';
import {themes,publications,projects} from '../lib/data';
const allThemes=await themes();const featuredPapers=(await publications()).filter(p=>p.data.featured).slice(0,3);const featuredProjects=(await projects()).filter(p=>p.data.featured).slice(0,3);
---
<Base title="Human-centered data experiences"><section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><div class="eyebrow">UNC–CHAPEL HILL · COMPUTER SCIENCE</div><h1>Making data <em>meaningful.</em></h1><p>We study how people perceive, understand, and interact with information—and design new technologies that make data more useful, intelligent, and inclusive.</p><a class="button" href={siteUrl("/research/")}>Explore our research <span aria-hidden="true">↗</span></a></div><div class="hero-art" aria-label="Abstract data visualization illustration" role="img"><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="dots">{Array.from({length:54},(_,i)=><span style={`--i:${i};--x:${(i*47)%91}%;--y:${(i*71)%89}%;--s:${5+(i%4)*4}px;--c:${['#4b9cd3','#b0b4e6','#62d495','#13283f'][i%4]}`}></span>)}</div><div class="art-label">HUMAN × DATA × DESIGN</div></div></div></section><section class="section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">What we explore</div><h2>Research directions</h2></div><a href={siteUrl("/research/")}>All research ↗</a></div><div class="card-grid">{allThemes.filter(t=>t.data.featured).map((theme,i)=><a class="card" href={siteUrl(`/research/${theme.id}/`)}><div class="card-visual">{theme.data.image?<img src={siteUrl(theme.data.image)} alt=""/>:<span>{String(i+1).padStart(2,'0')}</span>}</div><div class="card-body"><div class="pill">Research theme</div><h3>{theme.data.title}</h3><p>{theme.data.summary}</p></div></a>)}</div></div></section>{featuredProjects.length>0&&<section class="section tinted"><div class="wrap"><div class="section-head"><div><div class="eyebrow">In focus</div><h2>Featured projects</h2></div></div><div class="card-grid">{featuredProjects.map(project=><a class="card" href={siteUrl(`/projects/${project.id}/`)}><div class="card-visual">{project.data.image?<img src={siteUrl(project.data.image)} alt=""/>:'↗'}</div><div class="card-body"><h3>{project.data.title}</h3><p>{project.data.summary}</p></div></a>)}</div></div></section>}<section class="section"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Selected scholarship</div><h2>Featured publications</h2></div><a href={siteUrl("/publications/")}>All publications ↗</a></div>{featuredPapers.length?featuredPapers.map(p=><article class="pub"><div class="pill">{p.data.year} · {p.data.venueShort||p.data.venue}</div><h3>{p.data.title}</h3><p>{p.data.authors.join(', ')}</p><div class="pub-links">{p.data.links.map(l=><a href={siteUrl(l.url)}>{l.label} ↗</a>)}</div></article>):<p>Featured papers will appear here as publication records are added.</p>}</div></section><section class="cta"><div class="wrap"><div class="eyebrow">Work with us</div><h2>Curious about people, data, and design?</h2><p>We bring together perspectives from visualization, HCI, perception, and emerging technologies.</p><a class="button" href={siteUrl("/join/")}>Join the lab ↗</a></div></section></Base>
<style>.hero{background:linear-gradient(115deg,#f7fafc 0%,#f7fafc 60%,#eaf5fb 100%);overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;min-height:580px;align-items:center;gap:25px}.hero-copy{padding:65px 0}.hero h1{font-size:clamp(48px,6.4vw,88px);margin:23px 0 26px;max-width:700px}.hero h1 em{color:#4b9cd3;font-style:normal}.hero-copy p{font-size:19px;color:#536c80;max-width:600px;margin-bottom:30px}.hero-art{height:470px;position:relative;border-radius:50%;background:radial-gradient(circle at center,#e0f1fb 0%,#f5fafd 60%,transparent 73%)}.orbit{position:absolute;border:1px solid #9dcce8;border-radius:50%;top:12%;left:10%;width:80%;height:80%;transform:rotate(-25deg) scaleY(.55)}.orbit-b{transform:rotate(55deg) scaleY(.55)}.dots span{position:absolute;left:var(--x);top:var(--y);width:var(--s);height:var(--s);background:var(--c);border-radius:50%;opacity:.8}.art-label{position:absolute;bottom:10%;right:6%;font-size:11px;font-weight:800;letter-spacing:.17em;color:#608ca9}.tinted{background:#f7fafc}.cta{background:#e8f4fb;padding:75px 0}.cta h2{font-size:clamp(30px,4vw,48px);margin:12px 0}.cta p{color:#536c80;margin-bottom:25px}@media(max-width:750px){.hero-grid{grid-template-columns:1fr}.hero-art{height:260px;margin-top:-70px}.hero-copy{padding-bottom:25px}}</style>
