---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';export async function getStaticPaths(){return (await getCollection('publications')).map(p=>({params:{slug:p.id},props:{paper:p}}))}

const {paper}=Astro.props;const {Content}=await render(paper);
---
<Base title={paper.data.title}><section class="page-hero"><div class="wrap"><div class="eyebrow">{paper.data.year} · {paper.data.venue}</div><h1>{paper.data.title}</h1><p>{paper.data.authors.join(', ')}</p></div></section><div class="wrap prose"><div class="pub-links">{paper.data.links.map(l=><a href={l.url}>{l.label} ↗</a>)}{paper.data.doi&&<a href={`https://doi.org/${paper.data.doi}`}>DOI ↗</a>}</div>{paper.data.thumbnail&&<img src={paper.data.thumbnail} alt="Publication illustration" style="max-width:100%;margin-top:30px"/>}<h2>Abstract</h2><p>{paper.data.abstract||'Abstract forthcoming.'}</p><Content/>{paper.data.bibtex&&<><h2>BibTeX</h2><pre style="white-space:pre-wrap;overflow-wrap:anywhere">{paper.data.bibtex}</pre></>}</div></Base>
