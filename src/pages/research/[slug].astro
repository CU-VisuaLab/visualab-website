---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import {publications,projects} from '../../lib/data';export async function getStaticPaths(){return (await getCollection('themes')).map(t=>({params:{slug:t.id},props:{theme:t}}))}const {theme}=Astro.props;const {Content}=await render(theme);const papers=(await publications()).filter(p=>p.data.themes.includes(theme.id));const related=(await projects()).filter(p=>p.data.themes.includes(theme.id));
---
<Base title={theme.data.title}><section class="page-hero"><div class="wrap"><div class="eyebrow">Research direction</div><h1>{theme.data.title}</h1><p>{theme.data.summary}</p></div></section><div class="wrap"><div class="prose"><Content/></div>{related.length>0&&<section class="section"><div class="section-head"><h2>Projects</h2></div><div class="card-grid">{related.map(p=><a class="card" href={`/projects/${p.id}/`}><div class="card-body"><h3>{p.data.title}</h3><p>{p.data.summary}</p></div></a>)}</div></section>}<section class="section"><div class="section-head"><h2>Related publications</h2></div>{papers.map(p=><article class="pub"><div class="pill">{p.data.year} · {p.data.venue}</div><h3><a href={`/publications/${p.id}/`}>{p.data.title}</a></h3><p>{p.data.authors.join(', ')}</p></article>)}{papers.length===0&&<p>Publications will appear here when linked to this theme.</p>}</section></div></Base>
