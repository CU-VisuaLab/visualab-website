---
import { siteUrl } from '../lib/urls';
interface Props {title:string; description?:string}
const {title,description='VisuaLab at UNC–Chapel Hill: research at the intersection of human perception, cognition, visualization, and interaction.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title} | VisuaLab</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><header class="site-header"><div class="wrap nav"><a href={siteUrl("/")} class="wordmark" aria-label="VisuaLab homepage"><span class="v-mark">V</span>isuaLab<span class="period">.</span></a><nav aria-label="Main navigation"><a href={siteUrl("/research/")}>Research</a><a href={siteUrl("/publications/")}>Publications</a><a href={siteUrl("/people/")}>People</a><a href={siteUrl("/tools/")}>Tools</a><a href={siteUrl("/join/")}>Join Us</a></nav></div></header><main><slot/></main><footer><div class="wrap footer-inner"><div><strong>VisuaLab</strong><p>University of North Carolina at Chapel Hill<br/>Department of Computer Science</p></div><div><a href={siteUrl("/research/")}>Research</a><a href={siteUrl("/publications/")}>Publications</a><a href={siteUrl("/people/")}>People</a><a href={siteUrl("/tools/")}>Tools</a></div><span>© {new Date().getFullYear()} VisuaLab</span></div></footer></body></html>
<style is:global>@import '../styles/global.css';</style>
